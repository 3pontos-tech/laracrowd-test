includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    reportUnmatchedIgnoredErrors: false

    level: 1
    paths:
        - app/
        - app-modules/
        - database/
        - tests/
        - routes/

    excludePaths:
        - bootstrap/cache
        - app-modules/*/tests/*
        - tests
